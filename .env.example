# Required: use an API key from Alibaba Cloud Model Studio's Beijing region.
DASHSCOPE_API_KEY=your_api_key_here

# Optional workspace header for Qwen calls when required by your account.
DASHSCOPE_WORKSPACE_ID=
# Enable only if your workspace administrator requires X-DashScope-WorkSpace.
DASHSCOPE_SEND_WORKSPACE_HEADER=false

# Realtime models are fixed by the current tested path:
# qwen-audio-3.1-asr-flash-streaming -> qwen3.7-flash translation.
# DashScope hosts are added to NO_PROXY/no_proxy automatically.
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=zh

DEBUG=false
RAW_EVENT_DEBUG=false

# Keep Agent1 offline until its integration with the new realtime path is ready.
AGENT1_ENABLED=false
COURSE_ID=default-course
LECTURE_ID=default-lecture
# Optional path to the MinerU CLI used by process_course_ppt.py.
MINERU_BIN=
AGENT1_FIRST_TARGET_TOKENS=300
AGENT1_TARGET_TOKENS=700
AGENT1_MAX_TOKENS=1800
AGENT1_FIRST_MAX_WAIT_SECONDS=40
AGENT1_MAX_WAIT_SECONDS=60
AGENT1_TIME_TRIGGER_MIN_TOKENS=100
# Rolling semantic segmentation. The legacy token/time settings above remain
# parseable for old deployments but no longer cause a production semantic flush.
AGENT1_BOUNDARY_CHECK_START_TOKENS=900
AGENT1_MIN_BLOCK_TOKENS=450
AGENT1_LOOKAHEAD_RESERVE_TOKENS=180
AGENT1_BOUNDARY_RECHECK_GROWTH_TOKENS=200
AGENT1_BOUNDARY_PROVIDER=deepseek
AGENT1_BOUNDARY_MODEL=deepseek-flash
AGENT1_BOUNDARY_TIMEOUT_SECONDS=30
AGENT1_BOUNDARY_PROMPT_PATH=agents/agent1_boundary.md
AGENT1_OVERLAP_TOKENS=120
AGENT1_OUTPUT_PATH=data
AGENT1_FAKE_SLEEP_SECONDS=0
AGENT1_MAX_ATTEMPTS=2
AGENT1_SHUTDOWN_TIMEOUT_SECONDS=30
# Full IDs or suffixes such as B000001, comma-separated.
AGENT1_FAKE_FAIL_FIRST_BLOCKS=

# Post-class Agent1 v1. Auto-run is opt-in; the /agent1/run endpoint also starts it.
# Set the segmenter context window to the selected model's verified limit.
AGENT1_POSTCLASS_AUTO=false
# Agent1 provider/model are shared with Agent Lab and stored in
# agent_lab/agents/agent1/agent.json (default: qwen3.8-max).
AGENT1_SEGMENTER_CONTEXT_WINDOW_TOKENS=
AGENT1_SEGMENTER_MAX_OUTPUT_TOKENS=4096
AGENT1_SUMMARIZER_MAX_CONCURRENCY=4
AGENT1_MODEL_TIMEOUT_SECONDS=900

# Post-class Agent2: compact evidence retrieval and audited ASR corrections.
# Post-ASR enrichment is manual; optional overrides (otherwise reuse AGENT2).
# AGENT2_ENRICHMENT_PROVIDER=alibaba_cloud_model_studio
# AGENT2_ENRICHMENT_MODEL=qwen3.8-max
# AGENT2_ENRICHMENT_CONTEXT_WINDOW_TOKENS=<actual model context window>
# AGENT2_ENRICHMENT_MAX_OUTPUT_TOKENS=8192
# Empty context window reuses AGENT1_SEGMENTER_CONTEXT_WINDOW_TOKENS.
# Set a verified context window when using a different model.
# Both ASR correction and enrichment also support AGENT2_PROVIDER=codex.
# Set AGENT2_MODEL to an explicit Codex model (e.g. gpt-6.1-sol); this
# uses the CLI's stored ChatGPT login, with no Qwen/DeepSeek fallback.
AGENT2_PROVIDER=alibaba_cloud_model_studio
AGENT2_MODEL=qwen3.8-max
AGENT2_CONTEXT_WINDOW_TOKENS=
AGENT2_MAX_OUTPUT_TOKENS=8192
AGENT2_MAX_CONCURRENCY=2
AGENT2_MODEL_TIMEOUT_SECONDS=900

# Qwen Agent 1. Empty uses the still-supported Beijing
# compatible endpoint. Set the workspace-specific URL explicitly after
# confirming that business space's dedicated endpoint in the console.
PRE_AGENT_MODEL=qwen3.8-max
QWEN_MODEL=qwen3.7-flash
QWEN_BASE_URL=
QWEN_TIMEOUT_SECONDS=90
QWEN_MAX_ATTEMPTS=2
QWEN_MAX_OUTPUT_TOKENS=
AGENT1_PROMPT_PATH=agents/agent1.md

# DeepSeek OpenAI-compatible API for future agents. Keep the key separate from
# DASHSCOPE_API_KEY so providers cannot accidentally receive each other's key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2
